# Copy to .env.local (never commit real values). Level 1 demo mode needs NONE of these.
APP_MODE=demo                 # demo | live
APP_BASE_URL=http://localhost:3000

# Database (Level 2) - Supabase-compatible Postgres
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # server-only, never expose to client

# AI provider (Level 2) - NVIDIA NIM is OpenAI-compatible
AI_PROVIDER=mock              # mock | nvidia-nim
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=

# Secrets encryption for stored channel tokens (Level 3)
TOKEN_ENCRYPTION_KEY=

# Channels (Level 3)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
